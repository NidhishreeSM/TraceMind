# ==============================================================================
# TraceMind Backend Configuration
# Tagline: "Every incident teaches. Every resolution makes us smarter."
# ==============================================================================

# Database Connection
# For Postgres with Docker: postgresql://tracemind:tracemind_password@localhost:5432/tracemind
# Fallback for local dev when Docker is unavailable: sqlite:///./tracemind.db
DATABASE_URL=sqlite:///./tracemind.db

# Hindsight Persistent Agent Memory (Vectorize.io)
# HINDSIGHT_BASE_URL: Cloud endpoint (e.g. https://api.hindsight.vectorize.io) or local instance (http://localhost:8888)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=tracemind-production

# Groq AI Service
GROQ_API_KEY=your_groq_api_key_here
# Primary model: openai/gpt-oss-120b; Fallback model: qwen/qwen3-32b
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b

# Security & CORS
# React frontend origin allowed for CORS requests
FRONTEND_ORIGIN=http://localhost:3000

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

